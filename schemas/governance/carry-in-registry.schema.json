{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://faultwitness.local/schemas/governance/carry-in-registry.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source_gate", "target_gate", "debts"],
  "properties": {
    "schema_version": {"pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "source_gate": {"pattern": "^G[0-9]{2}$"},
    "target_gate": {"pattern": "^G[0-9]{2}$"},
    "debts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "description",
          "coverage",
          "owning_iteration",
          "validation_id",
          "gate_report_label",
          "reason"
        ],
        "properties": {
          "id": {"pattern": "^DEBT-G[0-9]{2}-[0-9]{3}$"},
          "description": {"type": "string", "minLength": 10},
          "coverage": {"enum": ["covered_by_target_gate", "not_covered"]},
          "owning_iteration": {
            "oneOf": [
              {"type": "string", "pattern": "^I-[0-9]{4}$"},
              {"type": "null"}
            ]
          },
          "validation_id": {
            "oneOf": [
              {"type": "string", "pattern": "^V-G[0-9]{2}-[0-9]{3}$"},
              {"type": "null"}
            ]
          },
          "gate_report_label": {
            "oneOf": [{"type": "string", "minLength": 3}, {"type": "null"}]
          },
          "reason": {"type": "string", "minLength": 10}
        }
      }
    }
  }
}
