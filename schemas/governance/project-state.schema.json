{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://faultwitness.local/schemas/governance/project-state.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "governance_version",
    "active_gate",
    "active_gate_status",
    "last_closed_gate",
    "active_plan",
    "active_report",
    "latest_release"
  ],
  "properties": {
    "governance_version": {"const": "2.0"},
    "active_gate": {"pattern": "^G[0-9]{2}$"},
    "active_gate_status": {
      "enum": ["not_started", "planned", "in_progress", "passed", "failed", "blocked"]
    },
    "last_closed_gate": {
      "oneOf": [{"type": "string", "pattern": "^G[0-9]{2}$"}, {"type": "null"}]
    },
    "active_plan": {"type": "string", "minLength": 1},
    "active_report": {"type": "string", "minLength": 1},
    "latest_release": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gate", "tag", "release_commit", "producer_commit", "evidence_manifest"],
      "properties": {
        "gate": {"pattern": "^G[0-9]{2}$"},
        "tag": {"pattern": "^gate/G[0-9]{2}-v[0-9]+$"},
        "release_commit": {"pattern": "^[0-9a-f]{40}$"},
        "producer_commit": {"pattern": "^[0-9a-f]{40}$"},
        "evidence_manifest": {"type": "string", "minLength": 1}
      }
    }
  }
}
