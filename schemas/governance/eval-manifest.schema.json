{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://faultwitness.local/schemas/governance/eval-manifest.schema.json",
  "oneOf": [
    {"$ref": "#/$defs/v1"},
    {"$ref": "#/$defs/v2"}
  ],
  "$defs": {
    "status": {
      "enum": [
        "pending",
        "running",
        "pass",
        "fail",
        "blocked",
        "not_applicable",
        "local_pass_pending_cross_platform"
      ]
    },
    "integration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reason"],
      "properties": {
        "status": {"enum": ["required", "pass", "not_applicable"]},
        "reason": {"type": "string", "minLength": 10}
      }
    },
    "v1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "eval_id",
        "gate",
        "iteration",
        "evaluated_revision",
        "status",
        "environments",
        "commands",
        "artifacts",
        "open_evidence"
      ],
      "properties": {
        "schema_version": {"pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "eval_id": {"pattern": "^EVAL-G[0-9]{2}-[0-9]{3}$"},
        "gate": {"pattern": "^G[0-9]{2}$"},
        "iteration": {"pattern": "^(I-[0-9]{4}|C-G[0-9]{2}-[0-9]{3}|A-G[0-9]{2}-[0-9]{3})$"},
        "evaluated_revision": {"type": "string", "minLength": 1},
        "status": {"$ref": "#/$defs/status"},
        "environments": {"type": "array", "items": {"type": "string"}, "minItems": 1},
        "commands": {"type": "array", "items": {"type": "string"}, "minItems": 1},
        "artifacts": {"type": "array", "items": {"type": "string"}, "minItems": 1},
        "evidence_urls": {"type": "array", "items": {"type": "string"}},
        "integrations": {
          "type": "object",
          "additionalProperties": {"$ref": "#/$defs/integration"}
        },
        "open_evidence": {"type": "array", "items": {"type": "string"}}
      }
    },
    "phase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phase_id",
        "status",
        "start_time",
        "end_time",
        "cache_key",
        "artifact_digest",
        "artifact_path",
        "private_artifact_uri",
        "execution_count",
        "inherited_from_manifest"
      ],
      "properties": {
        "phase_id": {"type": "string", "minLength": 3},
        "status": {"enum": ["pass", "metric_fail", "infra_failed", "blocked"]},
        "start_time": {"type": "string", "format": "date-time"},
        "end_time": {"type": "string", "format": "date-time"},
        "cache_key": {"pattern": "^[0-9a-f]{64}$"},
        "artifact_digest": {"pattern": "^[0-9a-f]{64}$"},
        "artifact_path": {"type": "string", "minLength": 3},
        "private_artifact_uri": {"oneOf": [{"type": "string", "minLength": 3}, {"type": "null"}]},
        "execution_count": {"type": "integer", "minimum": 0},
        "inherited_from_manifest": {
          "oneOf": [{"type": "string", "minLength": 3}, {"type": "null"}]
        }
      }
    },
    "v2": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "eval_id",
        "gate",
        "iteration",
        "candidate_sha",
        "evaluated_revision",
        "evidence_head_sha",
        "status",
        "subject_digests",
        "environment_fingerprint",
        "phases",
        "environments",
        "commands",
        "artifacts",
        "open_evidence"
      ],
      "properties": {
        "schema_version": {"const": "2.0.0"},
        "eval_id": {"pattern": "^EVAL-G[0-9]{2}-[0-9]{3}$"},
        "gate": {"pattern": "^G[0-9]{2}$"},
        "iteration": {"pattern": "^(I-[0-9]{4}|C-G[0-9]{2}-[0-9]{3}|A-G[0-9]{2}-[0-9]{3})$"},
        "candidate_sha": {"pattern": "^[0-9a-f]{40}$"},
        "evaluated_revision": {"pattern": "^[0-9a-f]{40}$"},
        "evidence_head_sha": {"pattern": "^[0-9a-f]{40}$"},
        "status": {"$ref": "#/$defs/status"},
        "subject_digests": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {"pattern": "^[0-9a-f]{64}$"}
        },
        "environment_fingerprint": {"pattern": "^[0-9a-f]{64}$"},
        "phases": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/phase"}},
        "environments": {"type": "array", "items": {"type": "string"}, "minItems": 1},
        "commands": {"type": "array", "items": {"type": "string"}, "minItems": 1},
        "artifacts": {"type": "array", "items": {"type": "string"}, "minItems": 1},
        "evidence_urls": {"type": "array", "items": {"type": "string"}},
        "integrations": {
          "type": "object",
          "additionalProperties": {"$ref": "#/$defs/integration"}
        },
        "open_evidence": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
